DATABASE_PATH=./data/cms.sqlite
# Direktori persisten untuk file upload. Wajib dibackup bersama database.
UPLOAD_STORAGE_PATH=./data/uploads
ADMISSION_FORM_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
# Lokasi arsip yang dibuat oleh `pnpm run backup`.
BACKUP_STORAGE_PATH=./data/backups
SEED_ADMIN_EMAIL=admin@example.com
# Wajib diganti; minimum 12 karakter. Hanya digunakan oleh pnpm run db:seed.
SEED_ADMIN_PASSWORD=
NEXT_PUBLIC_APP_THEME=classic
NEXT_PUBLIC_APP_BRAND_NAME=Cendekia
NEXT_PUBLIC_APP_NAME=Cendekia Hub
# Namespace QR untuk clone ini. Jangan diubah setelah kartu QR dicetak.
NEXT_PUBLIC_APP_QR_NAMESPACE=cendekia
# Comma-separated browser origins permitted to call /api/v1 in production.
# Localhost, 127.0.0.1, and ::1 over HTTP are automatically permitted outside production.
# MOBILE_API_CORS_ORIGINS=https://app.example.com,https://staging.example.com
