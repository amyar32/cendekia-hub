DATABASE_PATH=./data/cms.sqlite
# Direktori persisten untuk file upload. Wajib dibackup bersama database.
UPLOAD_STORAGE_PATH=./data/uploads
ADMISSION_FORM_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
# Lokasi arsip yang dibuat oleh `npm run backup`.
BACKUP_STORAGE_PATH=./data/backups
SEED_ADMIN_EMAIL=admin@example.com
# Wajib diganti; minimum 12 karakter. Hanya digunakan oleh npm run db:seed.
SEED_ADMIN_PASSWORD=
